# =============================================
# Estimador Agéntico de Copago — Variables de Entorno
# Copia este archivo como `.env` y rellena tus valores reales.
# NUNCA subas el archivo .env al repositorio.
# =============================================

# Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Notion API (https://www.notion.so/my-integrations)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_ROOT_PAGE_ID=your_notion_root_page_id_here

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
